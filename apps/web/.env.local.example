NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Where in-app content reports go (Discord/Slack incoming webhook, or any URL
# that accepts JSON). Optional: without it, reports only appear in the server
# log ("[report]"). Set it in Render → Environment for production.
REPORT_WEBHOOK_URL=

# Second song engine: MiniMax Music 2.5 on fal.ai ($0.15 per song). Optional:
# without it the studio only offers ACE-Step. Get a key at fal.ai → API Keys.
FAL_KEY=
# MiniMax has its own spending limits. Defaults: 3 songs per visitor per hour,
# 30 per day for the whole site (about $4.50 a day). 0 turns MiniMax off.
MINIMAX_LIMIT_PER_IP_HOUR=3
MINIMAX_LIMIT_PER_DAY=30
